# Copy to .env and fill in.

# Local dev: sqlite file. Production: a Postgres connection string
# (see README's Supabase migration note).
DATABASE_URL="file:./prisma/dev.db"

# Signs session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# Which brand this deployment serves. Must match a Tenant.slug row.
TENANT_SLUG="shakewallah"

# Copy to .env and fill in.

# Local dev: sqlite file. Production: a Postgres connection string
# (see README's Supabase migration note).
DATABASE_URL="file:./prisma/dev.db"

# Signs session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# Which brand this deployment serves. Must match a Tenant.slug row.
TENANT_SLUG="shakewallah"

# Optional: MSG91 for real OTP delivery. Leave unset to keep dev-mode OTP
# (code is returned in the API response, no SMS sent). See README.
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""
MSG91_COUNTRY_CODE="91"

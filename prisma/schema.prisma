// Prisma schema for the universal restaurant rewards platform.
// Local dev uses SQLite (zero setup). Swap the datasource provider to
// "postgresql" for production — see README for the Prisma Postgres note.
//
// Core identity model: Customer is GLOBAL (one identity across every
// restaurant), and Membership is the per-restaurant wallet — that's what
// makes "ShakeWallah 650pts / Bite Box 300pts" show up in one app instead
// of requiring N separate white-label apps.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// One row per restaurant/café/QSR on the platform. ShakeWallah is
// restaurant #1, not a special case — every other restaurant is a row
// here, discoverable in the same customer app.
model Restaurant {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  category      String // "Café", "QSR", "Fine dining", "Bakery", ...
  city          String?
  description   String?
  coverImageUrl String?
  lat           Float?
  lng           Float?
  themeJson     String // JSON: { primaryColor, logoUrl } for the restaurant's profile accent
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  outlets    Outlet[]
  rewards    Reward[]
  staffUsers StaffUser[]
  memberships Membership[]
  segments   Segment[]
  campaigns  Campaign[]

  @@index([active, category])
}

// One physical location. qrToken is printed once and never rotates.
model Outlet {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  qrToken      String     @unique
  address      String?
  lat          Float?
  lng          Float?
  createdAt    DateTime   @default(now())

  billClaims BillClaim[]
  staffUsers StaffUser[]

  @@index([restaurantId])
}

// One global identity per phone number. A customer with accounts at 3
// restaurants is 1 Customer row + 3 Membership rows, not 3 Customers.
model Customer {
  id        String    @id @default(cuid())
  phone     String    @unique
  name      String?
  birthday  DateTime?
  createdAt DateTime  @default(now())

  memberships Membership[]
  billClaims  BillClaim[]

  @@index([phone])
}

// The per-restaurant wallet. This is what the "My Rewards" home screen
// actually lists one row per — not the Customer, not the Restaurant.
model Membership {
  id           String     @id @default(cuid())
  customerId   String
  customer     Customer   @relation(fields: [customerId], references: [id])
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  tier         String     @default("Member")
  joinedAt     DateTime   @default(now())

  ledgerEntries      PointsLedgerEntry[]
  redemptions        Redemption[]
  campaignRecipients CampaignRecipient[]

  @@unique([customerId, restaurantId])
  @@index([restaurantId])
}

enum StaffRole {
  OUTLET_STAFF
  BRAND_ADMIN
}

// Outlet staff approve claims and fulfil redemptions for their outlet;
// brand admins see/manage the whole restaurant. outletId is null for a
// brand admin.
model StaffUser {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  outletId     String?
  outlet       Outlet?    @relation(fields: [outletId], references: [id])
  phone        String
  name         String
  role         StaffRole  @default(OUTLET_STAFF)
  createdAt    DateTime   @default(now())

  @@unique([restaurantId, phone])
  @@index([restaurantId])
}

enum OtpPurpose {
  CUSTOMER
  STAFF
}

// Short-lived login codes. restaurantId is null for CUSTOMER (phone is
// globally unique, no restaurant context needed to log a customer in) and
// required for STAFF (the same phone could staff two different
// restaurants with separate accounts).
model OtpCode {
  id           String      @id @default(cuid())
  restaurantId String?
  phone        String
  purpose      OtpPurpose
  code         String
  attempts     Int         @default(0)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime    @default(now())

  @@index([phone, purpose, restaurantId])
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

// A customer's self-reported bill, pending outlet staff confirmation.
// (outletId, billNo) is unique so the same bill can't be claimed twice.
// billDate is the date/time printed on the receipt (not createdAt, which
// is when the claim was submitted) — it drives the 24h claim window and
// the bill-number sequence check in src/lib/billSequence.ts.
model BillClaim {
  id           String      @id @default(cuid())
  outletId     String
  outlet       Outlet      @relation(fields: [outletId], references: [id])
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id])
  billNo       String
  billDate     DateTime
  amountPaise  Int
  photoUrl     String
  status       ClaimStatus @default(PENDING)
  rejectReason String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime    @default(now())

  ledgerEntry PointsLedgerEntry?

  @@unique([outletId, billNo])
  @@index([customerId])
  @@index([outletId, status])
  @@index([outletId, billDate])
}

// Append-only. A wallet's balance is Σ(delta), never a stored column —
// see the architecture plan for why.
model PointsLedgerEntry {
  id           String      @id @default(cuid())
  membershipId String
  membership   Membership  @relation(fields: [membershipId], references: [id])
  delta        Int
  reason       String
  billClaimId  String?     @unique
  billClaim    BillClaim?  @relation(fields: [billClaimId], references: [id])
  redemptionId String?     @unique
  redemption   Redemption? @relation(fields: [redemptionId], references: [id])
  createdAt    DateTime    @default(now())

  @@index([membershipId, createdAt])
}

// Per-restaurant catalog, editable by that restaurant's brand admin.
model Reward {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  title        String
  description  String?
  pointsCost   Int
  stock        Int?
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  redemptions Redemption[]

  @@index([restaurantId, active])
}

enum RedemptionStatus {
  ISSUED
  FULFILLED
  EXPIRED
}

// code is shown at the counter; staff mark it fulfilled once redeemed.
model Redemption {
  id            String           @id @default(cuid())
  membershipId  String
  membership    Membership       @relation(fields: [membershipId], references: [id])
  rewardId      String
  reward        Reward           @relation(fields: [rewardId], references: [id])
  code          String           @unique
  status        RedemptionStatus @default(ISSUED)
  fulfilledById String?
  fulfilledAt   DateTime?
  createdAt     DateTime         @default(now())

  ledgerEntry PointsLedgerEntry?
}

// --- CRM / campaign engine (V1 slice of the "restaurant CRM" vision) ---

enum SegmentRuleType {
  INACTIVE_DAYS // no ledger activity in the last N days (win-back)
  MIN_LIFETIME_SPEND // lifetime approved bill amount >= N rupees
  MIN_VISITS // count of approved bill claims >= N
}

// A restaurant-defined customer segment, evaluated on demand (no stored
// membership list — segments are rules, not snapshots, so they stay
// accurate as customers earn/spend).
model Segment {
  id           String          @id @default(cuid())
  restaurantId String
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id])
  name         String
  ruleType     SegmentRuleType
  ruleValue    Int
  createdAt    DateTime        @default(now())

  campaigns Campaign[]

  @@index([restaurantId])
}

enum CampaignStatus {
  DRAFT
  SENT
}

// V1 campaign = a message + an optional bonus-points reward, sent once to
// everyone in a segment (or the whole restaurant if segmentId is null).
// No push/SMS delivery yet — see CampaignRecipient and the README.
model Campaign {
  id           String         @id @default(cuid())
  restaurantId String
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id])
  segmentId    String?
  segment      Segment?       @relation(fields: [segmentId], references: [id])
  name         String
  message      String
  bonusPoints  Int            @default(0)
  status       CampaignStatus @default(DRAFT)
  createdAt    DateTime       @default(now())
  sentAt       DateTime?

  recipients CampaignRecipient[]

  @@index([restaurantId])
}

// One row per membership a campaign was sent to — the basis for the
// "opens / redemptions / ROI" reporting the CRM vision calls for, even
// though only sentAt is populated in V1.
model CampaignRecipient {
  id           String     @id @default(cuid())
  campaignId   String
  campaign     Campaign   @relation(fields: [campaignId], references: [id])
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id])
  sentAt       DateTime   @default(now())

  @@unique([campaignId, membershipId])
}
